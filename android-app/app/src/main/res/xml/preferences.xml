<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="# ПРОВАЙДЕРЫ"
        app:iconSpaceReserved="false">

        <Preference
            android:key="providers"
            android:title="> Управление провайдерами"
            android:summary="DeepSeek, OpenAI, GLM, Qwen и другие"
            android:icon="@drawable/ic_model"
            app:allowDividerBelow="true" />

        <Preference
            android:key="active_model"
            android:title="Модель"
            android:summary="deepseek-chat"
            android:icon="@drawable/ic_cube"
            app:allowDividerBelow="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# ИНТЕГРАЦИИ"
        app:iconSpaceReserved="false">

        <Preference
            android:key="telegram"
            android:title="Telegram Bot"
            android:summary="Токен и настройки бота"
            android:icon="@drawable/ic_telegram" />

        <Preference
            android:key="voice_stt"
            android:title="Голос (STT)"
            android:summary="Распознавание речи"
            android:icon="@drawable/ic_microphone" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# ОФОРМЛЕНИЕ"
        app:iconSpaceReserved="false">

        <Preference
            android:key="appearance"
            android:title="Терминал"
            android:summary="Стиль как на ruslan.team"
            android:icon="@drawable/ic_palette" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# ПОВЕДЕНИЕ"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="auto_start"
            android:title="Автозапуск"
            android:summary="Запускать gateway при старте"
            android:icon="@drawable/ic_shield"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="notifications"
            android:title="Уведомления"
            android:summary="Показывать статус в шторке"
            android:icon="@drawable/ic_notifications_settings"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# СИСТЕМА"
        app:iconSpaceReserved="false">

        <Preference
            android:key="send_log"
            android:title="Отправить лог"
            android:summary="Лог файл разработчику"
            android:icon="@drawable/ic_code" />

        <Preference
            android:key="about"
            android:title="О приложении"
            android:summary="v0.17.0 — Руслан Agent"
            android:icon="@drawable/ic_info" />

        <Preference
            android:key="system_info"
            android:title="Диагностика"
            android:summary="Логи, состояние, тест API"
            android:icon="@drawable/ic_code" />
    </PreferenceCategory>

</PreferenceScreen>
