<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="# ПРОВАЙДЕРЫ"
        app:iconSpaceReserved="false">

        <Preference
            android:key="providers"
            android:title="> Управление провайдерами"
            android:summary="DeepSeek, OpenAI, GLM, Qwen и другие"
            android:icon="@drawable/ic_model"
            app:allowDividerBelow="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# ПОВЕДЕНИЕ"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="auto_start"
            android:title="Автозапуск"
            android:summary="Запускать gateway при старте"
            android:icon="@drawable/ic_shield"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="notifications"
            android:title="Уведомления"
            android:summary="Показывать статус в шторке"
            android:icon="@drawable/ic_notifications_settings"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# TELEGRAM"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="telegram_enabled"
            android:title="Включить бота"
            android:summary="Получать сообщения через Telegram"
            android:icon="@drawable/ic_telegram"
            android:defaultValue="false" />

        <EditTextPreference
            android:key="telegram_token"
            android:title="Bot Token"
            android:summary="Токен от @BotFather"
            android:icon="@drawable/ic_telegram" />

        <EditTextPreference
            android:key="telegram_users"
            android:title="Разрешённые пользователи"
            android:summary="@username или ID через запятую"
            android:icon="@drawable/ic_profile" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="# СИСТЕМА"
        app:iconSpaceReserved="false">

        <Preference
            android:key="logs"
            android:title="> Логи"
            android:summary="Просмотр логов в реальном времени"
            android:icon="@drawable/ic_code" />
        <Preference
            android:key="send_log"
            android:title="Отправить лог"
            android:summary="Лог файл разработчику"
            android:icon="@drawable/ic_code" />

        <Preference
            android:key="about"
            android:title="О приложении"
            android:summary="Руслан Agent"
            android:icon="@drawable/ic_info" />
    </PreferenceCategory>

</PreferenceScreen>
