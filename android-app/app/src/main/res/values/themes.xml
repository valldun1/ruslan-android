<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Terminal Base Theme — ruslan.team style -->
    <style name="Theme.Ruslan" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Terminal colors -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryDark">@color/accent_green_dark</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorOnPrimary">@color/bg_primary</item>

        <!-- Backgrounds -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorSurfaceVariant">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>

        <!-- Terminal font -->
        <item name="android:fontFamily">monospace</item>

        <!-- Components -->
        <item name="materialButtonStyle">@style/Widget.Ruslan.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Ruslan.Card</item>
        <item name="switchStyle">@style/Widget.Ruslan.Switch</item>
    </style>

    <!-- Preference theme (uses same dark background) -->
    <style name="Theme.Ruslan.Preference" parent="Theme.Material3.Dark">
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Theme with ActionBar -->
    <style name="Theme.Ruslan.WithActionBar" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryDark">@color/accent_green_dark</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- No ActionBar variant -->
    <style name="Theme.Ruslan.NoActionBar" parent="Theme.Ruslan">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.Ruslan.Button" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Ruslan.Button.Secondary">
        <item name="backgroundTint">@color/btn_secondary_bg</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="strokeColor">@color/btn_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card style -->
    <style name="Widget.Ruslan.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Switch style -->
    <style name="Widget.Ruslan.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/accent_green</item>
        <item name="trackTint">@color/bg_surface</item>
    </style>

    <!-- Circular image shape -->
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
